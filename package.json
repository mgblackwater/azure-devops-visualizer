{
  "name": "azure-devops-visualizer",
  "version": "0.2.0",
  "private": true,
  "description": "Custom Azure DevOps work item visualizer (Timeline, Graph, Hierarchy, Calendar) built on Electron + React.",
  "main": "out/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "package": "electron-vite build && electron-builder --win --x64",
    "package:dir": "electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@fullcalendar/core": "^6.1.15",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/interaction": "^6.1.15",
    "@fullcalendar/react": "^6.1.15",
    "@fullcalendar/timegrid": "^6.1.15",
    "@mui/icons-material": "^6.1.8",
    "@mui/material": "^6.1.8",
    "@reduxjs/toolkit": "^2.3.0",
    "@xyflow/react": "^12.3.5",
    "dagre": "^0.8.5",
    "dompurify": "^3.4.2",
    "markdown-it": "^14.1.1",
    "mermaid": "^11.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.28.0",
    "styled-components": "^6.1.13",
    "vis-data": "^7.1.9",
    "vis-timeline": "^7.7.3"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.52",
    "@types/dompurify": "^3.2.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.9.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/styled-components": "^5.1.34",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^32.2.5",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
